# Example IA runtime configuration for Docker Compose.
# Copy to ia.env and update values before deployment.

# --- LLM / OpenRouter ---
OPENROUTER_API_KEY=change-me

# --- GitHub (optional, avoid rate limit) ---
GITHUB_TOKEN=

# --- LLM / OpenRouter ---
OPENROUTER_API_KEY=change-me
LLM_MODEL=openai/gpt-oss-120b:free

# --- GitHub PAT encryption (required for private repo storage) ---
ENCRYPTION_KEY=change-me-base64-fernet-key

# --- Backend Spring Boot accessible from IA ---
BACKEND_BASE_URL=

# --- RAG vectoriel (embeddings + Chroma) ---
# local = sentence-transformers (gratuit, hors ligne) | openrouter = API distante
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_LOCAL=all-MiniLM-L6-v2
EMBEDDING_MODEL_REMOTE=openai/text-embedding-3-small
CHROMA_PERSIST_DIR=./.chroma
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RAG_TOP_K=8
